<insel-file><![CDATA[
B 1 PLOTP
    3.1
    2.1
    5.1
    6.1
P 1
    'advanced_plot.gnu' % Gnuplot file name
    0               % Sort by decreasing Y?

B 2 DO
    3.1
P 2
    0               % Initial value
    60              % Final value
    0.01            % Increment

B 3 DO
P 3
    -25             % Initial value
    75              % Final value
    25              % Increment

B 4 CONST
P 4
    1000            % Constant value

B 5 PVI
    2.1
    4.1
    3.1
P 5
    0               % Module temperature is
    60              % Number of cells in series per module
    2               % Number of cells in parallel per module
    1               % Number of modules in series
    1               % Number of modules in parallel
    0.0167          % Single cell area
    1.998           % Single module area
    1.12            % Band gap
    0.282192E+00    % Coefficient of short-circuit current density
    0.128161E-03    % Temperature coefficient of short-circuit current
    0.224722E+04    % Coefficient of saturation current density (Shockley diode)
    0.000000E+00    % Coefficient of saturation current density (Recombination diode)
    0.899831E-04    % Series resistance
    0.137244E+00    % Parallel resistance
    0.138036E+01    % Diode ideality factor alpha
    2.000000        % Diode ideality factor beta
    0.000000E+00    % Bishop parameter a
    0.000000E+00    % Bishop parameter M
    0.000000E+00    % Bishop parameter Vbr
    5.0             % Module tolerance plus
    -5.0            % Module tolerance minus
    1.762           % Characteristic module length
    21.000          % Module weight
    0.70            % Absorption coefficient
    0.85            % Emission factor
    900.0           % Specific heat of a module
    43.0            % Nominal operating cell temperature
    25.0            % Initial cell temperature
    1E-5            % Single cell voltage error tolerance
    100             % Maximum number of iterations
    '000000'        % Product ID

B 6 MUL
    2.1
    5.1

]]>
</insel-file>
</vseit-network>
