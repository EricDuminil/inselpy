<insel-file><![CDATA[
B 1 DO
P 1
    1               % Initial value
    10000           % Final value
    1               % Increment

B 2 RAN1
P 2
    SEED            % Seed

B 3 GASDEV
P 3
    SEED            % Seed

B 4 DIFF
    3.1
    9.2

B 5 DIFF
    2.1
    9.1

B 6 AVE
    8.1
    8.2

B 7 AVEC
    1.1
    8.1
    8.2

B 8 ABS
    5.1
    4.1

B 9 READ
P 9
    2               % Number of values to be read per record
    1               % Number of records to be skipped on the first call
    './check_random_and_normal_consistency.dat' % File name
    '*'             % Fortran format

B 10 SCREEN
    6.1
    6.2
P 10
    '*'             % Format

B 11 PLOT
    7.1
    7.2
    7.3
P 11
    'advanced_plot.gnu' % Gnuplot file name
    0               % Sort by decreasing Y?

C   SEED
    1234            % Define global constant -- Block number : 12
]]>
</insel-file>
