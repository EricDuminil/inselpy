<insel-file><![CDATA[
B 1 PLOTP
    3.1
    2.1
    5.1
    6.1
P 1
    'advanced_plot.gnu' % Gnuplot file name
    0               % Sort by decreasing Y?

B 2 DO
    3.1
P 2
    0               % Initial value
    $u_max$         % Final value
    0.01            % Increment

B 3 DO
P 3
    -25             % Initial value
    75              % Final value
    25              % Increment

B 4 CONST
P 4
    1000            % Constant value

B 5 PVI
    2.1
    4.1
    3.1
P 5
    0               % Module temperature is
    $bp2$           % Number of cells in series per module
    $bp3$           % Number of cells in parallel per module
    $bp4$           % Number of modules in series
    $bp5$           % Number of modules in parallel
    $bp6$           % Single cell area
    $bp7$           % Single module area
    $bp8$           % Band gap
    $bp9$           % Coefficient of short-circuit current density
    $bp10$          % Temperature coefficient of short-circuit current
    $bp11$          % Coefficient of saturation current density (Shockley diode)
    $bp12$          % Coefficient of saturation current density (Recombination diode)
    $bp13$          % Series resistance
    $bp14$          % Parallel resistance
    $bp15$          % Diode ideality factor alpha
    $bp16$          % Diode ideality factor beta
    $bp17$          % Bishop parameter a
    $bp18$          % Bishop parameter M
    $bp19$          % Bishop parameter Vbr
    $bp20$          % Module tolerance plus
    $bp21$          % Module tolerance minus
    $bp22$          % Characteristic module length
    $bp23$          % Module weight
    $bp24$          % Absorption coefficient
    $bp25$          % Emission factor
    $bp26$          % Specific heat of a module
    $bp27$          % Nominal operating cell temperature
    $bp28$          % Initial cell temperature
    $bp29$          % Single cell voltage error tolerance
    $bp30$          % Maximum number of iterations
    '000000'        % Product ID

B 6 MUL
    2.1
    5.1

]]>
</insel-file>
</vseit-network>
